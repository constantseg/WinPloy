<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Version>2.0.1</Version>
    <Authors>Constant Segretain</Authors>
    <Product>WinPloy</Product>
    <Copyright>Copyright 2026 Constant Segretain</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Le SDK PowerShell embarque de nombreuses ressources localisées : seules les ressources françaises sont gardées. -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
