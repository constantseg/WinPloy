<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WinPloy.Core</RootNamespace>
    <AssemblyName>WinPloy.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Textes de l'interface : Strings.resx (anglais, langue neutre) et Strings.fr.resx. -->
    <Compile Update="Properties\Strings.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Strings.resx" />
    <EmbeddedResource Update="Properties\Strings.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.20" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts exécutés sur le poste cible dans la session WinRM (Windows PowerShell 5.1). -->
    <EmbeddedResource Include="Deployment\Remote\RemoteAction.ps1" LogicalName="WinPloy.RemoteAction.ps1" />
    <EmbeddedResource Include="Deployment\Remote\NewWorkDir.ps1" LogicalName="WinPloy.NewWorkDir.ps1" />
    <EmbeddedResource Include="Deployment\Remote\ReceiveFiles.ps1" LogicalName="WinPloy.ReceiveFiles.ps1" />
    <EmbeddedResource Include="Deployment\Remote\PullFromShare.ps1" LogicalName="WinPloy.PullFromShare.ps1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinPloy.Tests" />
  </ItemGroup>

</Project>
