<Window x:Class="WinPloy.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:WinPloy.Properties"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{x:Static p:Strings.Cred_Title}" Width="460">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogPrimaryButton}" Content="{x:Static p:Strings.Cred_UseAccount}" IsDefault="True" Click="BtnOk_Click" />
                <Button Style="{StaticResource DialogButton}" Content="{x:Static p:Strings.Cred_CurrentAccount}" IsCancel="True"
                        ToolTip="{x:Static p:Strings.Cred_CurrentAccountTooltip}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource DialogHeading}" Text="{x:Static p:Strings.Cred_Title}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                       Text="{x:Static p:Strings.Cred_Hint}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Cred_User}" />
            <TextBox x:Name="TxtUser" Tag="{x:Static p:Strings.Cred_UserPlaceholder}" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Cred_Password}" />
            <PasswordBox x:Name="PwdBox" />
        </StackPanel>
    </DockPanel>
</Window>
