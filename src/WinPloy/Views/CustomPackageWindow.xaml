<Window x:Class="WinPloy.Views.CustomPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:WinPloy.Properties"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{x:Static p:Strings.Custom_WindowTitle}" Width="640"
        FocusManager.FocusedElement="{Binding ElementName=TxtName}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOk" Style="{StaticResource DialogPrimaryButton}" Content="{x:Static p:Strings.Common_Save}" IsDefault="True" Click="BtnOk_Click" />
                <Button Style="{StaticResource DialogButton}" Content="{x:Static p:Strings.Common_Cancel}" IsCancel="True" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource DialogHeading}" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                       Text="{x:Static p:Strings.Custom_Hint}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Custom_Name}" />
            <TextBox x:Name="TxtName" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Custom_InstallScript}" />
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Common_Browse}" Margin="8,0,0,0" Click="BtnBrowseInstall_Click" />
                <TextBox x:Name="TxtInstall" Tag="{x:Static p:Strings.Custom_InstallPlaceholder}" />
            </DockPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Custom_UninstallScript}" />
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Common_Browse}" Margin="8,0,0,0" Click="BtnBrowseUninstall_Click" />
                <TextBox x:Name="TxtUninstall" Tag="{x:Static p:Strings.Custom_UninstallPlaceholder}" />
            </DockPanel>

            <CheckBox x:Name="ChkRunAsSystem" Content="{x:Static p:Strings.Custom_RunAsSystem}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,18"
                       Text="{x:Static p:Strings.Custom_RunAsSystemHint}" />

            <CheckBox x:Name="ChkIntegrity" Content="{x:Static p:Strings.Custom_Integrity}"
                      Margin="0,0,0,6" Checked="ChkIntegrity_Changed" Unchecked="ChkIntegrity_Changed" />
            <StackPanel Margin="28,0,0,0">
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="{x:Static p:Strings.Custom_IntegrityHint}" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnComputeHash" Content="{x:Static p:Strings.Custom_ComputeHash}" Click="BtnComputeHash_Click" />
                    <TextBlock x:Name="LblIntegrity" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
