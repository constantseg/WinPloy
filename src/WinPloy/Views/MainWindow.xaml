<Window x:Class="WinPloy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:WinPloy.Properties"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinPloy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}" Icon="/winploy.ico" Height="800" Width="1280" MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}" FontSize="13"
        Foreground="{StaticResource Brush.Text}" Background="{StaticResource Brush.Window}"
        Closing="Window_Closing" Closed="Window_Closed">

    <DockPanel>

        <!-- ======================= Barre de commandes ======================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Subtle}" Tag="&#xE77B;" Command="{Binding SetCredentialCommand}"
                            ToolTip="{x:Static p:Strings.Main_AccountTooltip}">
                        <TextBlock>
                            <Run Text="{x:Static p:Strings.Main_Account}" Foreground="{StaticResource Brush.TextSecondary}" />
                            <Run Text="{Binding CredentialLabel, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparator}" Margin="6,0" />
                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="{x:Static p:Strings.Main_SettingsTooltip}" />
                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE946;" Command="{Binding ShowAboutCommand}" ToolTip="{x:Static p:Strings.Main_About}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Image Source="/winploy.ico" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="WinPloy" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{x:Static p:Strings.Main_Install}" GroupName="Action" IsChecked="{Binding IsInstall}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{x:Static p:Strings.Main_Uninstall}" GroupName="Action" IsChecked="{Binding IsUninstall}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Btn.Primary}" Tag="&#xE768;" Content="{x:Static p:Strings.Main_Run}" MinWidth="112" Margin="12,0,0,0"
                            Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}"
                            ToolTip="{x:Static p:Strings.Main_RunTooltip}" />
                    <Button Style="{StaticResource Btn.Danger}" Tag="&#xE71A;" Content="{x:Static p:Strings.Main_Stop}" MinWidth="96" Margin="6,0,0,0"
                            Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" ToolTip="{x:Static p:Strings.Main_StopTooltip}" />
                    <Button Style="{StaticResource Btn.Subtle}" Tag="&#xE72C;" Content="{x:Static p:Strings.Main_Retry}"
                            Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}"
                            ToolTip="{x:Static p:Strings.Main_RetryTooltip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= Barre d'état ======================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="12,0" Height="28">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WindowTitle}" Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ======================= Espace de travail ======================= -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.6*" MinHeight="250" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" MinHeight="170" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Postes -->
                <Border Grid.Column="0" Style="{StaticResource Pane}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}"><TextBlock Style="{StaticResource StepNumber}" Text="1" /></Border>
                                <TextBlock Style="{StaticResource PaneTitle}" Text="{x:Static p:Strings.Main_Computers}" />
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Subtle}" Content="{x:Static p:Strings.Main_All}" Command="{Binding AddAllComputersCommand}" ToolTip="{x:Static p:Strings.Main_AllTooltip}" />
                                    <Button Style="{StaticResource Btn.Primary}" Tag="&#xE710;" Content="{x:Static p:Strings.Main_Add}" Margin="6,0,0,0"
                                            Command="{Binding AddSelectedComputersCommand}" CommandParameter="{Binding SelectedItems, ElementName=LstPcAll}"
                                            ToolTip="{x:Static p:Strings.Main_AddTooltip}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PcFoundLabel}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="12,12,12,12">
                            <TextBox DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource TextBox.Search}"
                                     Tag="{x:Static p:Strings.Main_PcSearchPlaceholder}" ToolTip="{x:Static p:Strings.Main_PcSearchTooltip}"
                                     Text="{Binding PcSearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchComputersCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <ListBox x:Name="LstPcAll" ItemsSource="{Binding FoundComputers}" SelectionMode="Extended"
                                     Tag="{x:Static p:Strings.Main_PcListEmpty}"
                                     ToolTip="{x:Static p:Strings.Main_PcListTooltip}" MouseDoubleClick="LstPcAll_MouseDoubleClick" />
                        </DockPanel>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                <!-- 2. Applications -->
                <Border Grid.Column="2" Style="{StaticResource Pane}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Subtle}" Tag="&#xE710;" Content="WinGet" Command="{Binding AddWingetPackageCommand}"
                                            ToolTip="{x:Static p:Strings.Main_AddWingetTooltip}" />
                                    <Button Style="{StaticResource Btn.Subtle}" Tag="&#xE710;" Content="{x:Static p:Strings.Main_File}" Command="{Binding AddCustomPackageCommand}"
                                            ToolTip="{x:Static p:Strings.Main_AddFileTooltip}" />
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE70F;" Command="{Binding EditSelectedPackageCommand}" ToolTip="{x:Static p:Strings.Main_EditPackageTooltip}" />
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE74D;" ToolTip="{x:Static p:Strings.Main_RemovePackagesTooltip}"
                                            Command="{Binding RemoveFromCatalogueCommand}" CommandParameter="{Binding SelectedItems, ElementName=GridCatalogue}" />
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE72C;" Command="{Binding RefreshCatalogueCommand}" ToolTip="{x:Static p:Strings.Main_RefreshCatalogueTooltip}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StepBadge}"><TextBlock Style="{StaticResource StepNumber}" Text="2" /></Border>
                                    <TextBlock Style="{StaticResource PaneTitle}" Text="{x:Static p:Strings.Main_Applications}" />
                                    <Border Style="{StaticResource CountBadge}">
                                        <TextBlock Style="{StaticResource CountText}" Text="{Binding CatalogueCount}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource PaneFooter}">
                            <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}" Tag="&#xE710;" Content="{x:Static p:Strings.Main_AddToDeployment}"
                                    Command="{Binding AddToBasketCommand}" CommandParameter="{Binding SelectedItems, ElementName=GridCatalogue}"
                                    ToolTip="{x:Static p:Strings.Main_AddToDeploymentTooltip}" />
                        </Border>
                        <DockPanel Margin="12,12,12,12">
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource TextBox.Search}" Tag="{x:Static p:Strings.Main_PkgFilterPlaceholder}" Margin="0,0,0,10"
                                     Text="{Binding PkgSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static p:Strings.Main_PkgFilterTooltip}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearPackageSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <DataGrid x:Name="GridCatalogue" ItemsSource="{Binding CatalogueView}" IsSynchronizedWithCurrentItem="False"
                                      SelectedItem="{Binding SelectedPackage}" SelectionMode="Extended" MouseDoubleClick="GridCatalogue_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static p:Strings.Main_ColName}" Binding="{Binding Name, Mode=OneWay}" Width="1.3*" ElementStyle="{StaticResource Cell.Strong}" />
                                    <DataGridTemplateColumn Header="{x:Static p:Strings.Main_ColType}" Width="100" SortMemberPath="TypeLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PackageTypeBadge}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static p:Strings.Main_ColId}" Binding="{Binding Id, Mode=OneWay}" Width="1*" ElementStyle="{StaticResource Cell.Secondary}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                <!-- 3. Déploiement -->
                <Border Grid.Column="4" Style="{StaticResource Pane}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}"><TextBlock Style="{StaticResource StepNumber}" Text="3" /></Border>
                                <TextBlock Style="{StaticResource PaneTitle}" Text="{x:Static p:Strings.Main_Deployment}" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="12,8,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.2*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE738;" ToolTip="{x:Static p:Strings.Main_RemoveTargetsTooltip}"
                                            Command="{Binding RemoveTargetsCommand}" CommandParameter="{Binding SelectedItems, ElementName=LstTargets}" />
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE74D;" ToolTip="{x:Static p:Strings.Main_ClearTargetsTooltip}" Command="{Binding ClearTargetsCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static p:Strings.Main_TargetedComputers}" />
                                    <Border Style="{StaticResource CountBadge}">
                                        <TextBlock Style="{StaticResource CountText}" Text="{Binding TargetCount}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LstTargets" Grid.Row="1" ItemsSource="{Binding Targets}" SelectionMode="Extended"
                                     Tag="{x:Static p:Strings.Main_TargetsEmpty}" />

                            <DockPanel Grid.Row="3" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE738;" ToolTip="{x:Static p:Strings.Main_RemoveBasketTooltip}"
                                            Command="{Binding RemoveFromBasketCommand}" CommandParameter="{Binding SelectedItems, ElementName=LstBasket}" />
                                    <Button Style="{StaticResource Btn.Icon}" Tag="&#xE74D;" ToolTip="{x:Static p:Strings.Main_ClearBasketTooltip}" Command="{Binding ClearBasketCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static p:Strings.Main_Applications}" />
                                    <Border Style="{StaticResource CountBadge}">
                                        <TextBlock Style="{StaticResource CountText}" Text="{Binding BasketCount}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LstBasket" Grid.Row="4" ItemsSource="{Binding Basket}" SelectionMode="Extended"
                                     Tag="{x:Static p:Strings.Main_BasketEmpty}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PackageTypeBadge}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />

            <!-- ======================= Suivi ======================= -->
            <Border Grid.Row="2" Style="{StaticResource Pane}">
                <Grid>
                    <TabControl>
                        <TabItem Header="{x:Static p:Strings.Main_TabHosts}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="80" />
                                    <RowDefinition Height="6" />
                                    <!-- Hauteur du détail ajustable à la souris, entre une et une dizaine de lignes. -->
                                    <RowDefinition Height="50" MinHeight="32" MaxHeight="420" />
                                </Grid.RowDefinitions>

                                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                                              ToolTip="{x:Static p:Strings.Main_DetailSplitterTooltip}" />

                                <Border Grid.Row="2" Style="{StaticResource PaneFooter}" Padding="12,6,6,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Tag="&#xE8C8;" VerticalAlignment="Top"
                                                Command="{Binding CopyHostDetailCommand}" ToolTip="{x:Static p:Strings.Main_CopyDetailTooltip}" />
                                        <TextBox Style="{StaticResource TextBox.ReadOnly}" Text="{Binding HostDetail, Mode=OneWay}"
                                                 Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="0">
                                    <DataGrid x:Name="GridHosts" ItemsSource="{Binding HostsView}" IsSynchronizedWithCurrentItem="False"
                                              SelectedItem="{Binding SelectedHost}" BorderThickness="0" RowStyle="{StaticResource HostRow}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{x:Static p:Strings.Main_ColComputer}" Binding="{Binding Poste, Mode=OneWay}" Width="150" ElementStyle="{StaticResource Cell.Strong}" />
                                            <DataGridTemplateColumn Header="{x:Static p:Strings.Main_ColState}" Width="120" SortMemberPath="Etat">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentPresenter Content="{Binding Etat}" ContentTemplate="{StaticResource StatusBadge}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="WinRM" Binding="{Binding WinRM, Mode=OneWay}" Width="105" ElementStyle="{StaticResource Cell.Secondary}" />
                                            <DataGridTemplateColumn Header="{x:Static p:Strings.Main_ColDetail}" Width="*" SortMemberPath="Info">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Info}" ToolTip="{Binding Info}" Style="{StaticResource Cell.Text}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{x:Static p:Strings.Main_ColDuration}" Binding="{Binding Duree, Mode=OneWay}" Width="70" ElementStyle="{StaticResource Cell.Secondary}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,30,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=GridHosts}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" FontSize="22" Foreground="{StaticResource Brush.Neutral}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{x:Static p:Strings.Main_HostsEmpty}"
                                                   Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{x:Static p:Strings.Main_TabResults}">
                            <Grid>
                                <DataGrid x:Name="GridResults" ItemsSource="{Binding Results}" BorderThickness="0" RowStyle="{StaticResource ResultRow}"
                                          MouseDoubleClick="GridResults_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static p:Strings.Main_ColTime}" Binding="{Binding Horodatage, Mode=OneWay, StringFormat=HH:mm:ss}" Width="80" ElementStyle="{StaticResource Cell.Secondary}" />
                                        <DataGridTextColumn Header="{x:Static p:Strings.Main_ColComputer}" Binding="{Binding Ordinateur, Mode=OneWay}" Width="140" ElementStyle="{StaticResource Cell.Strong}" />
                                        <DataGridTextColumn Header="{x:Static p:Strings.Main_ColApplication}" Binding="{Binding Paquet, Mode=OneWay}" Width="170" ElementStyle="{StaticResource Cell.Text}" />
                                        <DataGridTemplateColumn Header="{x:Static p:Strings.Main_ColStatus}" Width="110" SortMemberPath="Statut">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding Statut}" ContentTemplate="{StaticResource StatusBadge}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static p:Strings.Main_ColMessage}" Width="*" SortMemberPath="Message">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" Style="{StaticResource Cell.Text}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{x:Static p:Strings.Main_ResultsEmpty}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,30,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=GridResults}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{x:Static p:Strings.Main_TabLog}">
                            <TextBox x:Name="LogBox" Style="{StaticResource TextBox.ReadOnly}" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" Padding="12,8" />
                        </TabItem>
                    </TabControl>

                    <!-- Progression, compteurs et export, à droite des onglets -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Height="42" Margin="0,0,8,0">
                        <ProgressBar Width="110" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Value="{Binding ProgressValue, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HostFilter" ToolTip="{x:Static p:Strings.Main_FilterAllTooltip}"
                                     IsChecked="{Binding HostFilterMode, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                            <TextBlock Text="{Binding TotalCount, StringFormat={x:Static p:Strings.Main_FilterAll}}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HostFilter" Background="#E6F0FA" Foreground="{StaticResource Brush.Accent}"
                                     ToolTip="{x:Static p:Strings.Main_FilterRunningTooltip}"
                                     IsChecked="{Binding HostFilterMode, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <TextBlock Text="{Binding RunningCount, StringFormat={x:Static p:Strings.Main_FilterRunning}}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HostFilter" Background="#E5F3E3" Foreground="#0E6B0E"
                                     ToolTip="{x:Static p:Strings.Main_FilterOkTooltip}"
                                     IsChecked="{Binding HostFilterMode, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                            <TextBlock Text="{Binding OkCount, StringFormat={x:Static p:Strings.Main_FilterOk}}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="HostFilter" Background="#FBE4E2" Foreground="{StaticResource Brush.Danger}"
                                     ToolTip="{x:Static p:Strings.Main_FilterFailedTooltip}"
                                     IsChecked="{Binding HostFilterMode, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                            <TextBlock Text="{Binding FailedCount, StringFormat={x:Static p:Strings.Main_FilterFailed}}" />
                        </RadioButton>
                        <TextBox Style="{StaticResource TextBox.Search}" Width="150" Margin="10,0,0,0" VerticalAlignment="Center" MinHeight="28"
                                 Tag="{x:Static p:Strings.Main_HostFilterPlaceholder}" ToolTip="{x:Static p:Strings.Main_HostFilterTooltip}"
                                 Text="{Binding HostFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Rectangle Style="{StaticResource ToolbarSeparator}" Margin="8,0,4,0" />
                        <Button Style="{StaticResource Btn.Icon}" Tag="&#xE78C;" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"
                                ToolTip="{x:Static p:Strings.Main_ExportTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
