<Window x:Class="WinPloy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:WinPloy.Properties"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{x:Static p:Strings.Settings_Title}" Width="640"
        FocusManager.FocusedElement="{Binding ElementName=TxtCataloguePath}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogPrimaryButton}" Content="{x:Static p:Strings.Common_Save}" IsDefault="True" Click="BtnSave_Click" />
                <Button Style="{StaticResource DialogButton}" Content="{x:Static p:Strings.Common_Cancel}" IsCancel="True" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource DialogHeading}" Text="{x:Static p:Strings.Settings_Title}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                       Text="{x:Static p:Strings.Settings_Hint}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Catalogue}" />
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Common_Browse}" Margin="8,0,0,0" Click="BtnBrowse_Click" />
                <TextBox x:Name="TxtCataloguePath" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                       Text="{x:Static p:Strings.Settings_CatalogueHint}" />

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Timeout}" />
                    <TextBox x:Name="TxtTimeout" Margin="0,0,0,6" />
                    <TextBlock x:Name="LblTimeoutHint" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Parallel}" />
                    <TextBox x:Name="TxtParallel" Margin="0,0,0,6" TextChanged="TxtParallel_TextChanged" />
                    <TextBlock x:Name="LblParallelHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_WinRm}" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="{x:Static p:Strings.Settings_Port}" />
                    <TextBox x:Name="TxtWinRmPort" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox x:Name="ChkUseSsl" Content="{x:Static p:Strings.Settings_Https}" Margin="0,0,0,8"
                              Checked="ChkUseSsl_Changed" Unchecked="ChkUseSsl_Changed" />
                    <CheckBox x:Name="ChkSkipCertificate" Content="{x:Static p:Strings.Settings_SkipCert}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18" TextWrapping="Wrap"
                       Text="{x:Static p:Strings.Settings_WinRmHint}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Transfer}" />
            <RadioButton x:Name="RadTransferWinRm" GroupName="Transfer" Margin="0,0,0,6"
                         Content="{x:Static p:Strings.Settings_TransferWinRm}" />
            <RadioButton x:Name="RadTransferSmb" GroupName="Transfer" Margin="0,0,0,6"
                         Content="{x:Static p:Strings.Settings_TransferSmb}" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="{x:Static p:Strings.Settings_TransferHint}" Margin="0,0,0,18" />

            <Separator Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Language}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CmbLanguage" Width="200" DisplayMemberPath="Value" SelectedValuePath="Key" />
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static p:Strings.Settings_LanguageHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
